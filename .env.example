# Servidor
APP_ADDR=:8080
DEBUG=false
HF_INPUT_COST_PER_MILLION_USD=0.132
HF_OUTPUT_COST_PER_MILLION_USD=0.528
JEV_INPUT_COST_PER_MILLION_USD=0.042
JEV_OUTPUT_COST_PER_MILLION_USD=0.042
WEB_DIST=web/dist
DESIGN_SYSTEM_DIR=design_system

# Hugging Face Inference Providers
HF_TOKEN=hf_seu_token_aqui
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-120b:fastest
HF_MAX_TOKENS=12000
MOCK_HF=false

# TypeSafe / Jev icon selection
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
ICON_SELECTOR=hf

# Local rendering of generated Python
GENERATED_OUTPUT_DIR=generated
PYTHON_BIN=python3
